---
import { Icon } from 'astro-icon/components';

const isHomePage = Astro.url.pathname === '/';
---

<footer class="base-border mt-8 w-full border-t">
  <div class="mx-auto flex w-full max-w-[800px] items-center px-5 py-3 text-sm">
    <a
      href="/"
      class="base-button-animation inline-flex items-center gap-1 rounded-md px-1.5 py-1 font-medium text-neutral-600 transition-colors hover:text-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-500 dark:text-neutral-400 dark:hover:text-white"
      aria-current={isHomePage ? 'page' : undefined}
    >
      <Icon name="bi:arrow-left" size={16} aria-hidden="true" />
      Back to home
    </a>
  </div>
</footer>
