---
import { SEO } from 'astro-seo';

import config from '@/config';
import StructuredData from './StructuredData.astro';

interface Props {
	title: string;
	description: string;
	includeSiteTitle?: boolean;

	// Article
	published_time: string;
	modified_time?: string;
	author: string[];
	section: string;
	tags: string[];
	canonical?: string;
	image: string;
	imageType?: string;
}

const {
	title,
	description,
	includeSiteTitle,
	published_time,
	modified_time,
	author,
	section,
	tags,
	canonical,
	image,
	imageType,
} = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, config.url).toString();
const pageTitle = includeSiteTitle ? `${title} | ${config.siteTitle}` : title;
const imageUrl = new URL(image, config.url).toString();
const person = {
	'@type': 'Person',
	name: author[0] ?? config.author,
	url: config.url,
	sameAs: Object.values(config.social),
};
const openGraphArticleMeta = [
	{ property: 'article:published_time', content: published_time },
	...(modified_time
		? [{ property: 'article:modified_time', content: modified_time }]
		: []),
	...author.map((name) => ({ property: 'article:author', content: name })),
	{ property: 'article:section', content: section },
	...tags.map((tag) => ({ property: 'article:tag', content: tag })),
];
const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'BlogPosting',
		headline: title,
		description,
		image: imageUrl,
		url: canonicalUrl,
		mainEntityOfPage: canonicalUrl,
		datePublished: published_time,
		dateModified: modified_time ?? published_time,
		author: person,
		publisher: person,
		keywords: tags.join(', '),
		articleSection: section,
		isPartOf: {
			'@type': 'Blog',
			name: config.siteTitle,
			url: new URL('/posts', config.url).toString(),
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{
				'@type': 'ListItem',
				position: 1,
				name: 'Home',
				item: config.url,
			},
			{
				'@type': 'ListItem',
				position: 2,
				name: 'Posts',
				item: new URL('/posts', config.url).toString(),
			},
			{
				'@type': 'ListItem',
				position: 3,
				name: title,
				item: canonicalUrl,
			},
		],
	},
];
---

<SEO
  title={pageTitle}
  canonical={canonicalUrl}
  description={description}
  openGraph={{
    basic: {
      title: pageTitle,
      type: 'article',
      image: imageUrl,
      url: canonicalUrl,
    },
    image: {
      alt: pageTitle,
      height: 630,
      width: 1200,
      ...(imageType ? { type: imageType } : {}),
    },
  }}
  twitter={{
    card: "summary_large_image",
    creator: config.twitter,
    image: imageUrl,
    imageAlt: pageTitle,
    site: config.twitter,
  }}
  extend={{
    meta: [
      ...openGraphArticleMeta,
      { property: "og:description", content: description },
      { property: "og:site_name", content: config.siteTitle },
    ],
  }}
/>
<StructuredData data={structuredData} />
