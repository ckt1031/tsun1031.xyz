---
import { SEO } from 'astro-seo';

import config from '@/config';
import StructuredData from './StructuredData.astro';

interface Props {
	title: string;
	description: string;
	includeSiteTitle?: boolean;
	noindex?: boolean;
	type?: 'website' | 'profile';
	canonical?: string;
	image?: string;
}

const {
	title,
	description,
	includeSiteTitle,
	noindex,
	type = 'website',
	canonical,
	image = '/og.jpeg',
} = Astro.props;
const canonicalUrl =
	canonical ?? new URL(Astro.url.pathname, config.url).toString();
const pageTitle = includeSiteTitle ? `${title} | ${config.siteTitle}` : title;
const imageUrl = new URL(image, config.url).toString();
const sameAs = Object.values(config.social);
const websiteId = `${config.url}/#website`;
const person = {
	'@id': `${config.url}/#person`,
	'@type': 'Person',
	name: config.author,
	url: config.url,
	sameAs,
};
const structuredData = [
	{
		'@id': websiteId,
		'@type': 'WebSite',
		name: config.siteTitle,
		url: config.url,
		description: config.description,
		author: person,
	},
	{
		'@id': `${canonicalUrl}#webpage`,
		'@type': type === 'profile' ? 'ProfilePage' : 'WebPage',
		name: title,
		headline: title,
		description,
		url: canonicalUrl,
		isPartOf: {
			'@id': websiteId,
		},
		about: type === 'profile' ? person : undefined,
	},
];
---

<SEO
  title={pageTitle}
  canonical={canonicalUrl}
  description={description}
  noindex={noindex}
  openGraph={{
    basic: {
      title: pageTitle,
      type,
      image: imageUrl,
    },
    image: {
      alt: pageTitle,
      height: 630,
		type: 'image/jpeg',
      width: 1200,
    },
  }}
  twitter={{
    card: "summary_large_image",
    creator: config.twitter,
    image: imageUrl,
    imageAlt: pageTitle,
    site: config.twitter,
    title: pageTitle,
    description: description,
  }}
  extend={{
    meta: [
      { property: "og:description", content: description },
      { property: "og:site_name", content: config.siteTitle },
    ],
  }}
/>
<StructuredData data={structuredData} />
