---
import { Picture } from 'astro:assets';

type WithRequiredDimensions<T> = T extends unknown
	? Omit<T, 'height' | 'width'> & {
			height: number;
			width: number;
		}
	: never;

type ResponsivePictureProps<T> = T extends unknown
	? Omit<
			T,
			'fallbackFormat' | 'formats' | 'layout' | 'widths' | 'densities' | 'sizes'
		>
	: never;

type Props = WithRequiredDimensions<
	ResponsivePictureProps<Parameters<typeof Picture>[0]>
>;
---

<Picture
    {...Astro.props}
    fallbackFormat="jpeg"
    formats={["avif", "webp"]}
    layout="constrained"
    sizes="(max-width: 800px) 100vw, 800px"
/>
