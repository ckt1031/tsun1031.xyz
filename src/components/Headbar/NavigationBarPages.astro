---
import config from '@/config';

const currentPath = Astro.url.pathname;
---

<nav class="hidden flex-row gap-1 md:flex">
  {
    config.headbar.routes.map((item) => (
      <a
        href={item.href}
        data-astro-prefetch
        class:list={[
          'nav-link',
          {
            'nav-link-active':
              currentPath === item.href ||
              (item.href !== '/' && currentPath.startsWith(item.href)),
          },
        ]}
      >
        {item.name}
      </a>
    ))
  }
</nav>
