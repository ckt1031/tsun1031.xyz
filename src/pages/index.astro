---
import MainSEO from '@components/SEO/Main.astro';
import { Icon } from 'astro-icon/components';

import Avatar from '@/assets/avatar.png';
import PostList from '@/components/Posts/List.astro';
import config from '@/config';
import MainLayout from '@/layouts/main.astro';
import { getPublishedPosts, sortPostsByPublishedDate } from '@/utils/posts';
import OptimizedPicture from '@/components/OptimizedPicture.astro';

const socialMedia = [
	{
		name: 'GitHub',
		icon: 'bi:github',
		link: config.social.github,
	},
	{
		name: 'Instagram',
		icon: 'bi:instagram',
		link: config.social.instagram,
	},
	{
		name: 'LinkedIn',
		icon: 'bi:linkedin',
		link: config.social.linkedin,
	},
	{
		name: 'Twitter',
		icon: 'bi:twitter',
		link: config.social.twitter,
	},
];

const recentPosts = sortPostsByPublishedDate(await getPublishedPosts()).slice(0, 8);
---

<MainLayout padded={false}>
  <MainSEO
    slot="head"
    title="Kelvin Chan | Software, Electronics, and Personal Blog"
    description={config.description}
    type="profile"
  />
  <section class="my-10 flex flex-row gap-3 md:gap-5 items-center">
    <div
      class="flex-none overflow-hidden rounded-full"
      style="inline-size: 5.5rem; block-size: 5.5rem;"
    >
      <OptimizedPicture
        alt="ckt1031's Avatar"
        src={Avatar}
        class="h-full w-full object-cover"
        height={256}
        width={256}
      />
    </div>
    <div class="flex flex-col gap-1">
        <h1 class="text-2xl font-bold">Kelvin Chan</h1>
        <p class="text-lg font-medium italic text-neutral-600 dark:text-neutral-300">
        An undergraduate student in HKUST, majoring in Electronics Engineering.
        </p>
    </div>
  </section>

  <p class="mb-8">
      My name is Chan Ka Tsun / Kelvin (Chan) / ckt1031, I'm interested in computers, software and AI, also a reader and a thinker.
  </p>

  <div class="mb-12 w-full space-y-8">
    <section aria-labelledby="contact-heading">
      <h2 id="contact-heading" class="text-xl font-semibold">Contact & Social</h2>
      <p class="mt-2">
        I’m available via
        <span> </span>
        <a class="underline" href="mailto:kelvin@tsun1031.xyz">
          kelvin@tsun1031.xyz
        </a>
        , Discord, and Instagram DMs.
      </p>
      <div class="mt-3 flex flex-wrap gap-2 text-neutral-800 dark:text-neutral-300">
        {
          socialMedia.map((item) => (
            <a
              href={item.link}
              class="flex items-center gap-1.5 rounded-lg border border-neutral-300 px-1.5 py-0.5 dark:border-neutral-600"
              target="_blank"
              rel="noreferrer"
            >
              <Icon name={item.icon} size={16} />
              <span>{item.name}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="details-heading" class="space-y-4">
      <h2 id="details-heading" class="text-xl font-semibold">Details</h2>
      <p>
        Currently year 3 in HKUST, expected to graduate in 2028 May,
        still thinking whether to continue my study in HKUST or go abroad for a master degree,
        but I think I will choose local univeristy.
      </p>
      <p>
        I started coding when I was 13 years old, which is 7 years ago,
        my first coding language is JavaScript, and it was a Discord bot in Discord.js,
        then I started to learn Python, Go, Dart, Kotlin, C, C++, and now I can code in these languages.
        Everything is learned by myself, unsupervised, and this is really wonderful to train myself
        and build solving skills in period of time without AI.
      </p>
      <p>
        Free time is my favorite time, I like to read books, watch Netflix, and play games,
        my favorite sports are badminton and basketball, I also like to play chess,
        although I am not good at it lol.
      </p>
    </section>

    <section aria-labelledby="posts-heading" class="base-border border-t pt-8">
      <h2 id="posts-heading" class="text-xl font-semibold">
        <a class="group inline-flex items-center gap-1 hover:underline" href="/posts">
          Posts
          <Icon
            name="bi:arrow-right"
            size={16}
            class="ml-1 text-neutral-600 transition-transform duration-200 ease-out group-hover:translate-x-1"
          />
        </a>
      </h2>
      <div class="mt-2">
        <PostList allPosts={recentPosts} />
      </div>
    </section>
  </div>
</MainLayout>
