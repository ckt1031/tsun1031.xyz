---
import { Picture } from 'astro:assets';
import MainSEO from '@components/SEO/Main.astro';
import { Icon } from 'astro-icon/components';

import Avatar from '@/assets/avatar.png';
import PostList from '@/components/Posts/List.astro';
import config from '@/config';
import MainLayout from '@/layouts/main.astro';
import { getPublishedPosts, sortPostsByPublishedDate } from '@/utils/posts';

const socialMedia = [
	{
		name: 'GitHub',
		icon: 'hugeicons:github',
		link: config.social.github,
	},
	{
		name: 'Instagram',
		icon: 'hugeicons:instagram',
		link: config.social.instagram,
	},
	{
		name: 'Twitter',
		icon: 'hugeicons:new-twitter',
		link: config.social.twitter,
	},
];

const recentPosts = sortPostsByPublishedDate(await getPublishedPosts()).slice(0, 8);
---

<MainLayout padded={false}>
  <MainSEO
    slot="head"
    title="Kelvin Chan | Software, Electronics, and Personal Blog"
    description={config.description}
    type="profile"
  />
  <section class="my-10 flex flex-row gap-3 md:gap-5 items-center">
    <div
      class="flex-none overflow-hidden rounded-full"
      style="inline-size: 5.5rem; block-size: 5.5rem;"
    >
      <Picture
        alt="ckt1031's Avatar"
        src={Avatar}
        class="h-full w-full object-cover"
        height={150}
        width={150}
      />
    </div>
    <div class="flex flex-col gap-1">
        <h1 class="text-2xl font-bold">Kelvin Chan</h1>
        <p class="text-lg font-medium italic text-neutral-600 dark:text-neutral-300">
        An undergraduate student in Hong Kong University of Science and
        Technology.
        </p>
    </div>
  </section>

  <div class="mb-12 w-full space-y-8">
    <section aria-labelledby="contact-heading">
      <h2 id="contact-heading" class="text-xl font-semibold">Contact & Social</h2>
      <p class="mt-2">
        I’m available via
        <span> </span>
        <a class="underline" href="mailto:kelvin@tsun1031.xyz">
          kelvin@tsun1031.xyz
        </a>
        , Discord, and Instagram DMs.
      </p>
      <div class="mt-3 flex flex-wrap gap-2 text-neutral-800 dark:text-neutral-300">
        {
          socialMedia.map((item) => (
            <a
              href={item.link}
              class="flex items-center gap-1.5 rounded-lg border border-neutral-300 px-1.5 py-0.5 dark:border-neutral-600"
              target="_blank"
              rel="noreferrer"
            >
              <Icon name={item.icon} size={16} />
              <span>{item.name}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="details-heading" class="space-y-4">
      <h2 id="details-heading" class="text-xl font-semibold">Details</h2>
      <p>
        An undergraduate student of SENG in HKUST, studying Electronics
        Engineering (ELEC), currently year 3.
      </p>
      <p>
        Interested in computer, in both hardware and software, I also want to
        learn more about machine learning as well, I think AI is the most
        important thing in coming decades.
      </p>
      <p>
        Also like to discuss and think about social and political issues, which
        these parts are the most direct way to reflect how good and how smart is
        this person.
      </p>
    </section>

    <section aria-labelledby="posts-heading" class="base-border border-t pt-8">
      <h2 id="posts-heading" class="text-xl font-semibold">
        <a class="group inline-flex items-center gap-1 hover:underline" href="/posts">
          Blog posts
          <Icon
            name="hugeicons:arrow-right-02"
            size={20}
            class="text-neutral-600 transition-transform duration-200 ease-out group-hover:translate-x-1"
          />
        </a>
      </h2>
      <div class="mt-2">
        <PostList allPosts={recentPosts} />
      </div>
    </section>
  </div>
</MainLayout>
