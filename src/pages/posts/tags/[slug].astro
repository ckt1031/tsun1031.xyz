---
import '@/styles/post.css';

import PostList from '@components/Posts/List.astro';
import MainSEO from '@components/SEO/Main.astro';

import PageTitle from '@/components/PageTitle.astro';
import MainLayout from '@/layouts/main.astro';
import { getPublishedPosts, sortPostsByPublishedDate } from '@/utils/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();

	const tags = new Set(posts.flatMap((post) => post.data.tags ?? []));

	return [...tags].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;

// get all posts with the same tag
const posts = sortPostsByPublishedDate(
	(await getPublishedPosts()).filter((post) =>
		post.data.tags?.includes(slug ?? ''),
	),
);

// Meta data
const meta = {
	title: `Posts tagged with ${slug}`,
	description: `Browse Kelvin Chan's blog posts tagged with ${slug}.`,
};
---

<MainLayout>
	<MainSEO slot="head" includeSiteTitle title={meta.title} description={meta.description} />
	<div class="mb-2">
		<PageTitle title={`Posts tagged with "${slug}"`} />
	</div>
	<PostList allPosts={posts} />
</MainLayout>
