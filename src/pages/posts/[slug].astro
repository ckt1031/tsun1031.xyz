---
import '@/styles/post.css';

import { render } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import dayjs from 'dayjs';

import ArticleSEO from '@/components/SEO/Article.astro';
import ExternalLink from '@/components/Posts/ExternalLink.astro';
import MainLayout from '@/layouts/main.astro';
import {
	formatHongKongDate,
	formatHongKongISOString,
	formatHongKongShortDate,
} from '@/utils/date';
import { getPublishedPosts } from '@/utils/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();

	return posts.map((post) => {
		return {
			params: { slug: post.id },
			props: { post },
		};
	});
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props;
const { Content } = await render(post);
const publishedTime = formatHongKongISOString(post.data.published);
const updatedDate = post.data.updated;
const isUpdated =
	updatedDate && !dayjs(updatedDate).isSame(post.data.published, 'second');
const modifiedTime = isUpdated ? formatHongKongISOString(updatedDate) : undefined;
---

<MainLayout>
  <ArticleSEO
    slot="head"
    includeSiteTitle
    title={post.data.title}
    description={post.data.description}
    author={["ckt1031"]}
    published_time={publishedTime}
    modified_time={modifiedTime}
    tags={post.data.tags || []}
    section={post.data.tags ? post.data.tags[0] : "post"}
    canonical={post.data.canonical}
  />
  <article class="mb-20 mt-5 w-full">
    <header class="base-border mb-7 border-b pb-6">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-medium text-neutral-500 dark:text-neutral-400">
        <time datetime={publishedTime} title={formatHongKongDate(post.data.published)}>
          Published {formatHongKongShortDate(post.data.published)}
        </time>
        {
          isUpdated && updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <time datetime={modifiedTime} title={formatHongKongDate(updatedDate)}>
                Updated {formatHongKongShortDate(updatedDate)}
              </time>
            </>
          )
        }
      </div>
      <h1 class="text-xl break-words font-extrabold md:text-2xl">
        {post.data.title}
      </h1>
      <p class="mt-2 max-w-2xl text-base leading-6 text-neutral-600 dark:text-neutral-300">
        {post.data.description}
      </p>
    </header>
    <div class="blog-style">
      <Content components={{ a: ExternalLink }} />
    </div>
    {
      post.data.tags && (
        <div class="base-border mt-7 border-t">
          <div class="mt-5">
            <p class="mb-2 font-medium">Tags:</p>
            {post.data.tags.map((tag: string) => (
              <a class="post-tag " href={`/posts/tags/${tag}`}>
                {tag}
              </a>
            ))}
          </div>
        </div>
      )
    }
  </article>
</MainLayout>
