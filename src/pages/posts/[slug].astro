---
import '@/styles/post.css';

import { render } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';

import ArticleSEO from '@/components/SEO/Article.astro';
import ExternalLink from '@/components/Posts/ExternalLink.astro';
import MarkdownTable from '@/components/Posts/MarkdownTable.astro';
import MainLayout from '@/layouts/main.astro';
import {
	formatHongKongDate,
	formatHongKongISOString,
	formatHongKongShortDate,
} from '@/utils/date';
import { getPostModifiedDate, getPublishedPosts } from '@/utils/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();

	return posts.map((post) => {
		return {
			params: { slug: post.id },
			props: { post },
		};
	});
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props;
const { Content } = await render(post);
const publishedTime = formatHongKongISOString(post.data.published);
const modifiedDate = getPostModifiedDate(post.data);
const modifiedTime = modifiedDate
	? formatHongKongISOString(modifiedDate)
	: undefined;
---

<MainLayout>
  <ArticleSEO
    slot="head"
    includeSiteTitle
    title={post.data.title}
    description={post.data.description}
    author={["ckt1031"]}
    published_time={publishedTime}
    modified_time={modifiedTime}
    tags={post.data.tags || []}
    section={post.data.tags ? post.data.tags[0] : "post"}
    canonical={post.data.canonical}
  />
  <article class="mb-20 w-full">
    <header class="base-border mb-7 border-b pb-6">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-medium text-neutral-500 dark:text-neutral-400">
        <time datetime={publishedTime} title={formatHongKongDate(post.data.published)}>
          Published {formatHongKongShortDate(post.data.published)}
        </time>
        {
          modifiedDate && (
            <>
              <span aria-hidden="true">·</span>
              <time datetime={modifiedTime} title={formatHongKongDate(modifiedDate)}>
                Modified {formatHongKongShortDate(modifiedDate)}
              </time>
            </>
          )
        }
      </div>
      <h1 class="text-xl break-words font-extrabold md:text-2xl">
        {post.data.title}
      </h1>
      <p class="mt-2 max-w-2xl text-base leading-6 text-neutral-600 dark:text-neutral-300">
        {post.data.description}
      </p>
      {
        post.data.tags && (
          <div class="mt-5 flex flex-wrap gap-x-2 gap-y-1">
            {post.data.tags.map((tag: string) => (
              <a
                class="text-sm font-medium text-neutral-600 hover:underline dark:text-neutral-400"
                href={`/posts/tags/${tag}`}
              >
                #{tag}
              </a>
            ))}
          </div>
        )
      }
    </header>
    <div class="blog-style">
      <Content components={{ a: ExternalLink, table: MarkdownTable }} />
    </div>
  </article>
</MainLayout>

<script>
	import mediumZoom from 'medium-zoom';

	const copyIcon = `<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>`;
	const checkIcon = `<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"></path></svg>`;

	mediumZoom('.blog-style img', {
		background: 'rgba(10, 10, 10, 0.9)',
		margin: 24,
	});

	document.querySelectorAll<HTMLPreElement>('.blog-style pre.astro-code').forEach(
		(codeBlock) => {
			const code = codeBlock.querySelector('code');
			if (!code) return;

			const button = document.createElement('button');
			button.type = 'button';
			button.className = 'code-copy-button';
			button.setAttribute('aria-label', 'Copy code');
			button.title = 'Copy code';
			button.innerHTML = copyIcon;

			button.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(code.textContent ?? '');
					button.innerHTML = checkIcon;
					button.setAttribute('aria-label', 'Copied');
					button.title = 'Copied';

					window.setTimeout(() => {
						button.innerHTML = copyIcon;
						button.setAttribute('aria-label', 'Copy code');
						button.title = 'Copy code';
					}, 2000);
				} catch {
					button.setAttribute('aria-label', 'Unable to copy code');
					button.title = 'Unable to copy code';
				}
			});

			const wrapper = document.createElement('div');
			wrapper.className = 'code-block-wrapper';
			codeBlock.before(wrapper);
			wrapper.append(codeBlock, button);
		},
	);
</script>
